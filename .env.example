# ---- Promptify configuration -------------------------------------------
# Copy this file to `.env` and edit. `.env` is gitignored — never commit it.

# Server port. Render/Railway/Heroku set PORT for you.
PORT=3000

# Base URL encoded into the QR code (no trailing slash).
#   Blank  -> auto-detected from the request. Correct behind a proxy AND on a
#             laptop only if every device reaches you by that host.
#   Laptop -> REQUIRED, or phones scan a localhost link that opens nothing:
#             PUBLIC_URL=http://192.168.1.50:3000
#   Cloud  -> PUBLIC_URL=https://your-app.onrender.com
PUBLIC_URL=

# MongoDB connection string.
#   Blank  -> boots a local MongoDB, files persisted in ./data (zero setup)
#   Atlas  -> mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/promptify
#            (always name a database, e.g. /promptify, so you don't land in
#             another application's database)
MONGODB_URI=

# Where the fallback MongoDB keeps its files
DB_PATH=./data

# Secret used to sign login tokens. CHANGE THIS in production.
JWT_SECRET=promptify-change-me-in-production

# Organizer account created on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=promptify2026

# Print demo logins on the login screens. KEEP false FOR THE LIVE EVENT.
LOGIN_HINTS=false

# Event settings
EVENT_YEAR=2026
CHALLENGE_MINUTES=30
CHALLENGE_GRACE_MINUTES=2

# Optional: DNS servers for this process only (comma separated). Needed only
# when Node's own resolver is broken and mongodb+srv fails instantly with
# "querySrv ECONNREFUSED". Leave blank otherwise.
DNS_SERVERS=
